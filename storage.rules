rules_version = '2';

// Totali · Portal do Cliente — regras do Storage (consultam o Firestore: exige o papel Firebase Rules Firestore Service Agent para o agente service-NUMERO@gcp-sa-firebasestorage; o CLI só concede em modo interativo)
// Arquivos vivem em empresas/{empresaId}/documentos/{docId}/{nome}
// e empresas/{empresaId}/chat/{anexoId}/{nome}. Quem lê e escreve é
// quem pode ver a empresa: a equipe ou o cliente vinculado.
// A página da contabilidade anterior (sem conta) entra com login
// anônimo e prova o código do link nos metadados do arquivo.
service firebase.storage {
  match /b/{bucket}/o {
    function logado() { return request.auth != null; }
    function ehEquipe() { return logado() && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)); }
    function ehDono(empresaId) { return logado() && firestore.exists(/databases/(default)/documents/empresas/$(empresaId)/acessos/$(request.auth.uid)); }
    function ehAnonimo() { return logado() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    // Contabilidade anterior: login anônimo + código do link nos metadados do arquivo
    function codigoAnteriorValido(empresaId) {
      return request.resource.metadata != null && 'codigo' in request.resource.metadata
             && linkAnteriorOk(firestore.get(/databases/(default)/documents/anterior/$(request.resource.metadata.codigo)).data, empresaId);
    }
    function linkAnteriorOk(a, empresaId) {
      return a.empresaId == empresaId && a.ativo == true && (!('expiraEm' in a) || a.expiraEm > request.time.toMillis());
    }
    // Contabilidade anterior manda de tudo (ZIP, RAR, áudio, vídeo, pfx…): o servidor confere o conteúdo depois
    // (triagem.js apaga programas). Aqui só barra o que se declara executável ou página da web.
    function tipoPerigoso() {
      return request.resource.contentType.matches('application/(x-msdownload|x-msdos-program|x-dosexec|x-executable|x-sh|x-bat|x-msi|java-archive|vnd[.]microsoft[.]portable-executable|javascript|x-javascript|xhtml[+]xml|hta)|text/(html|javascript)');
    }
    function tipoOk() {
      return request.resource.contentType.matches('application/pdf|image/.*|application/xml|text/.*|application/zip|application/x-pkcs12|application/vnd.*|application/msword|audio/.*|video/.*|application/octet-stream');
    }

    match /empresas/{empresaId}/{area}/{id}/{nome} {
      allow read: if ehEquipe() || ehDono(empresaId);
      // As regras do Storage só podem consultar o Firestore 2 vezes por envio: cada caminho abaixo usa no máximo 2
      // (antes o visitante anônimo passava por "é equipe?" e "é cliente?" antes do link e estourava o limite).
      allow create: if
        // contabilidade anterior pelo link sem login: até 300 MB, qualquer tipo que não se declare executável
        (ehAnonimo() && area == 'documentos' && request.resource.size < 300 * 1024 * 1024 && !tipoPerigoso() && codigoAnteriorValido(empresaId))
        // equipe: arquivos comuns, e o pacote da contabilidade anterior que chegou por e-mail (até 300 MB)
        || (!ehAnonimo() && ehEquipe() && ((request.resource.size < 25 * 1024 * 1024 && tipoOk())
                                           || (area == 'documentos' && request.resource.size < 300 * 1024 * 1024 && !tipoPerigoso())))
        // cliente: até 25 MB, tipos de documento
        || (!ehAnonimo() && ehDono(empresaId) && request.resource.size < 25 * 1024 * 1024 && tipoOk());
      allow update: if false;
      allow delete: if ehEquipe() || ehDono(empresaId);
    }

    // Imagens dos banners de divulgação (Painel › Vitrine): a equipe envia, todo mundo logado vê
    match /sistemas/{sistema}/{nome} {
      allow read: if logado();
      allow create: if ehEquipe() && request.resource.size < 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow update: if false;
      allow delete: if ehEquipe();
    }
    match /vitrine/{campanha}/{nome} {
      allow read: if logado();
      allow create: if ehEquipe() && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow update: if false;
      allow delete: if ehEquipe();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
