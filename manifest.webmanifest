{
  "name": "Portal do Cliente · Totali Soluções Contábeis",
  "short_name": "Totali",
  "description": "Chat com a sua equipe contábil, documentos, jornada de 30 dias e todos os sistemas da Totali em um login só.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./index.html#/inicio",
  "scope": "./",
  "id": "totali-portal-cliente",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f5f7fa",
  "theme_color": "#182c43",
  "categories": ["business", "finance", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Chat com a Totali", "short_name": "Chat", "url": "./index.html#/chat", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Enviar documento", "short_name": "Documentos", "url": "./index.html#/documentos", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Minha jornada", "short_name": "Jornada", "url": "./index.html#/jornada", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
