rules_version = '2';

// ============================================================
// Totali · Portal de Onboarding — regras do Firestore
//
// Princípio: a tela esconde, a regra impede. Nada aqui confia no
// que o navegador manda. O que não estiver escrito não existe —
// a última regra nega tudo o que sobrou.
//
// SEM CLOUD FUNCTIONS
// -------------------
// Esta versão não depende de Cloud Functions. O vínculo entre o
// cliente e a empresa dele nasce do CONVITE, e o acesso do dia a
// dia é feito com e-mail e senha.
//
// Como funciona:
//   1. A equipe cadastra a empresa e gera um convite. O link
//      carrega só um código longo e aleatório.
//   2. O cliente abre o link uma vez e cria a senha dele. Nesse
//      momento o portal registra /empresas/{id}/acessos/{uid} e
//      /clientes/{uid}, e QUEIMA o convite.
//   3. Dali em diante ele entra com e-mail e senha, sem o link.
//
// Convite queimado não serve mais: se o link for encaminhado ou
// vazar depois, não dá acesso a ninguém.
//
// Quem é quem:
//   cliente  e-mail e senha; enxerga só a empresa do convite dele
//   equipe   e-mail e senha, e existe em /usuarios/{uid}
//   admin    membro da equipe com papel "admin"
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quem está pedindo ----------

    function logado() {
      return request.auth != null;
    }

    // Membro da equipe: precisa ter documento em /usuarios/{uid}.
    // Apagar o documento corta o acesso na hora, sem mexer na conta.
    function ehEquipe() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function ehAdmin() {
      return ehEquipe() &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'admin';
    }

    // O cliente provou o convite e registrou o próprio uid.
    function ehDonoDaEmpresa(empresaId) {
      return logado() &&
             exists(/databases/$(database)/documents/empresas/$(empresaId)/acessos/$(request.auth.uid));
    }

    function equipeOuDono(empresaId) {
      return ehEquipe() || ehDonoDaEmpresa(empresaId);
    }

    // ---------- Utilidades ----------

    // Para ALTERAR: nenhum campo fora da lista pode ser tocado.
    function soEstesCampos(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Para CRIAR: o documento não pode nascer com campo fora da lista.
    //
    // Por que esta função existe, e por que ela é diferente da de
    // cima: `diff(resource.data)` só funciona quando JÁ EXISTE um
    // documento para comparar. Na criação não existe, e por isso a
    // trava de alteração simplesmente não vale ali.
    //
    // Foi exatamente essa brecha que apareceu no teste de
    // 2026-08-18: `allow create` não tinha trava de campo nenhuma,
    // então o cliente conseguia CRIAR um documento de item já com
    // `revisao: {status:"aprovado"}` — carimbando de aprovado um
    // documento que ele nunca enviou. Alterar era negado; criar,
    // não. A regra de alteração dava uma falsa sensação de que o
    // campo estava protegido.
    function soEstesCamposAoCriar(campos) {
      return request.resource.data.keys().hasOnly(campos);
    }

    function textoAte(valor, max) {
      return valor is string && valor.size() <= max;
    }

    // ---------- Convites ----------
    //
    // O código é o segredo, e ele só existe dentro do link. Ler
    // um convite exige saber o código inteiro (get por id);
    // listar é proibido, então não dá para varrer a coleção.

    match /convites/{codigo} {
      allow get: if true;
      allow list: if ehEquipe();
      allow create, delete: if ehEquipe();

      // A equipe altera à vontade. O cliente só pode QUEIMAR o
      // convite que ele acabou de usar — e só isso, num caminho
      // sem volta: de ativo para inativo, nunca o contrário.
      allow update: if ehEquipe()
                    || (logado()
                        && resource.data.ativo == true
                        && request.resource.data.ativo == false
                        && request.resource.data.usadoPor == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['ativo', 'usadoPor', 'usadoEm']));
    }

    // ---------- De qual empresa é cada cliente ----------
    //
    // Criado junto com o acesso. Serve para o portal descobrir,
    // no login seguinte, qual empresa carregar — sem o link.
    match /clientes/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || ehEquipe();

      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.empresaId is string
                    && exists(/databases/$(database)/documents/empresas/$(request.resource.data.empresaId)/acessos/$(uid));

      allow update: if false;
      allow delete: if ehEquipe();

      // ---------- Uma pessoa, várias empresas ----------
      //
      // É comum o mesmo dono ter dois ou três CNPJs. O campo
      // `empresaId` acima guarda um só e não pode ser alterado —
      // então esta lista é como o portal descobre TODAS as
      // empresas daquele login.
      //
      // Não é ela que dá permissão: quem autoriza continua sendo
      // /empresas/{id}/acessos/{uid}. Aqui é só um índice, e por
      // isso o cliente só consegue escrever uma entrada se o
      // acesso correspondente já existir. Listar empresa que não
      // é dele não leva a lugar nenhum: a leitura da empresa
      // continua exigindo o documento de acesso.
      //
      // A EQUIPE TAMBÉM ESCREVE AQUI, e por um motivo concreto:
      // é ela que dá a uma pessoa já cadastrada o acesso a uma
      // segunda empresa, pelo painel. Sem isto, aquele botão
      // gravaria a autorização e não o índice — e o portal, que
      // descobre a lista por este índice, mostraria só a primeira
      // empresa. Metade do vínculo é pior que nenhum.
      match /empresas/{empresaId} {
        allow read: if (logado() && request.auth.uid == uid) || ehEquipe();

        allow create: if ehEquipe()
                      || (logado()
                          && request.auth.uid == uid
                          && exists(/databases/$(database)/documents/empresas/$(empresaId)/acessos/$(uid)));

        allow update: if ehEquipe();
        allow delete: if ehEquipe();
      }
    }

    // ---------- Empresas ----------

    match /empresas/{empresaId} {
      allow read: if equipeOuDono(empresaId);

      // Quem cadastra a empresa é a equipe, pelo painel.
      allow create: if ehEquipe()
                    && textoAte(request.resource.data.razaoSocial, 150)
                    && request.resource.data.razaoSocial.size() > 2
                    && textoAte(request.resource.data.cnpj, 20);

      // O cliente completa o contato dele; razão social, CNPJ e
      // regime são da equipe e ele não altera.
      allow update: if ehEquipe()
                    || (ehDonoDaEmpresa(empresaId) && soEstesCampos([
                         'responsavelNome', 'responsavelEmail',
                         'responsavelTelefone', 'responsavelCargo',
                         'etapa', 'aceiteLGPD', 'atualizadoEm'
                       ]));

      allow delete: if ehAdmin();

      // ---------- Acessos: o cliente prova o convite ----------
      //
      // Só dá para registrar o PRÓPRIO uid, e só apresentando um
      // código de convite que aponte para esta empresa. Sem o
      // código não há acesso; com o código, só para esta empresa.
      //
      // UM LINK, VÁRIAS EMPRESAS
      // É comum o mesmo dono ter dois ou três CNPJs. O convite
      // pode listar mais de uma empresa em `empresas`, e aí o
      // acesso vale para qualquer uma DA LISTA — nunca para fora
      // dela. `empresaId` continua sendo a principal, e é o que
      // os convites antigos têm.
      match /acessos/{uid} {
        allow read: if ehEquipe() || request.auth.uid == uid;

        allow create: if ehEquipe()
                      || (logado()
                          && request.auth.uid == uid
                          && request.resource.data.codigo is string
                          && exists(/databases/$(database)/documents/convites/$(request.resource.data.codigo))
                          && get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.ativo == true
                          && (
                               get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.empresaId == empresaId
                               || (get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.get('empresas', []) is list
                                   && empresaId in get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.get('empresas', []))
                             ));

        // Registro de acesso não se reescreve. Para revogar,
        // a equipe apaga — e o cliente perde o acesso na hora.
        allow update: if false;
        allow delete: if ehEquipe();
      }

      // ---------- Documentos do checklist ----------
      //
      // O cliente mexe no ENVIO; a revisão é da equipe. `revisao`
      // fora desta lista é o que impede o cliente de aprovar o
      // próprio documento — e a trava precisa valer na criação E na
      // alteração, senão basta criar o documento já aprovado.
      //
      // `lembrete` é do cliente: é a data em que ele mesmo se
      // comprometeu a voltar neste documento ("enviar depois").
      // Não muda a situação do item — continua faltando — e por
      // isso pode ficar na mão dele sem risco nenhum.
      //
      // `naEquipe` é o contrário: é a Totali dizendo se aquele
      // documento se aplica àquela empresa. Não está na lista do
      // cliente, então ele nunca grava esse campo. E enquanto ele
      // existir, o cliente também não mexe no `na` dele — é o que
      // faz "a definição da equipe prevalece" ser verdade no
      // servidor, e não só na tela.
      match /itens/{chave} {
        allow read: if equipeOuDono(empresaId);

        allow create: if ehEquipe()
                      || (ehDonoDaEmpresa(empresaId) && soEstesCamposAoCriar([
                           'arquivos', 'valor', 'na', 'forma',
                           'obs', 'atualizadoEm', 'lembrete'
                         ]));
        allow update: if ehEquipe()
                      || (ehDonoDaEmpresa(empresaId)
                          && soEstesCampos([
                               'arquivos', 'valor', 'na', 'forma',
                               'obs', 'atualizadoEm', 'lembrete'
                             ])
                          && (!('naEquipe' in resource.data)
                              || !('na' in request.resource.data.diff(resource.data).affectedKeys())));
        allow delete: if ehAdmin();
      }

      // ---------- Sócios ----------
      // Só nome e CPF. Nada de campo extra entrando de carona.
      match /socios/{socioId} {
        allow read: if equipeOuDono(empresaId);
        allow create, update: if equipeOuDono(empresaId)
                              && textoAte(request.resource.data.nome, 120)
                              && request.resource.data.keys().hasOnly(['nome', 'cpf']);
        allow delete: if equipeOuDono(empresaId);
      }

      // ---------- Credenciais (senhas cifradas) ----------
      //
      // O conteúdo já chega embaralhado pelo aparelho do cliente
      // e só abre com a chave privada da Totali. Ainda assim,
      // leitura é só de admin: menos gente vendo, menos risco.
      //
      // A LEITURA DEIXOU DE SER SÓ DE ADMIN, e é de propósito.
      // Estas senhas são de LEITURA DE RELATÓRIO de maquininha,
      // não de movimentar dinheiro, e a equipe inteira precisa
      // delas no dia a dia. Exigir que uma pessoa só conseguisse
      // abrir levava ao pior desfecho possível: print da senha
      // indo para o WhatsApp.
      //
      // O que a equipe lê aqui continua sendo o ENVELOPE FECHADO.
      // Quem abre é a Cloud Function `abrirCredencial`, e cada
      // abertura vira registro em /auditoria com nome e hora.
      match /credenciais/{chave} {
        allow read: if ehEquipe() || ehDonoDaEmpresa(empresaId);
        allow create, update: if ehDonoDaEmpresa(empresaId)
                              && request.resource.data.pacote is map
                              && request.resource.data.pacote.alg is string
                              && request.resource.data.pacote.dados is string
                              && request.resource.data.pacote.dados.size() < 20000
                              // Barreira contra gravar senha às claras por engano.
                              && !('senha' in request.resource.data)
                              && !('login' in request.resource.data);
        allow delete: if ehAdmin() || ehDonoDaEmpresa(empresaId);
      }

      // ---------- Financeiro ----------
      match /financeiro/{doc} {
        allow read: if equipeOuDono(empresaId);
        allow create, update: if equipeOuDono(empresaId);
        allow delete: if ehAdmin();
      }

      // ---------- Mensagens ----------
      //
      // Cada um escreve como si mesmo. Mensagem enviada não se
      // reescreve nem se apaga: o histórico precisa valer alguma
      // coisa. O que muda depois do envio são só as marcas.
      //
      // `lidaEm`      qualquer um dos dois lados marca.
      // `resolvidaEm` e `resolvidaPor` são CONTROLE INTERNO da
      //               equipe: dizem que alguém já tomou a
      //               providência que a mensagem pedia. Ler não é
      //               resolver, e por isso são marcas separadas.
      //               O cliente não escreve nelas — se pudesse,
      //               poderia dar por resolvido o próprio pedido.
      match /mensagens/{msgId} {
        allow read: if equipeOuDono(empresaId);

        allow create: if textoAte(request.resource.data.texto, 4000)
                      && ((ehEquipe() && request.resource.data.autor == 'equipe')
                          || (ehDonoDaEmpresa(empresaId) && request.resource.data.autor == 'cliente'));

        allow update: if (ehEquipe() && soEstesCampos(['lidaEm', 'resolvidaEm', 'resolvidaPor']))
                      || (ehDonoDaEmpresa(empresaId) && soEstesCampos(['lidaEm']));
        allow delete: if ehAdmin();
      }

      // ---------- Anotações internas ----------
      //
      // O que a equipe precisa lembrar e o cliente não pode ler:
      // "o contador anterior não entrega o balanço", "só atende
      // depois das 18h". Antes isso vivia no WhatsApp de quem
      // atendeu e sumia quando essa pessoa saía de férias.
      //
      // Coleção separada, e não campo dentro da empresa: o cliente
      // lê a empresa inteira, então campo escondido lá seria
      // segredo só na aparência. Aqui `read` exige equipe, e não
      // há caminho pelo qual o cliente veja ou liste isto.
      match /notas/{notaId} {
        allow read: if ehEquipe();
        allow create, update: if ehEquipe()
                              && textoAte(request.resource.data.texto, 2000)
                              && request.resource.data.keys().hasOnly(['texto', 'por', 'em']);
        allow delete: if ehEquipe();
      }

      // ---------- Trilha de auditoria ----------
      //
      // ATENÇÃO, e isto precisa estar claro: sem Cloud Functions,
      // quem grava aqui é o próprio navegador. A regra impede
      // apagar e reescrever, mas NÃO impede o cliente de inventar
      // um evento. Serve para acompanhar e depurar; NÃO tem valor
      // probatório. Vira prova quando for gravada pelo servidor.
      match /eventos/{eventoId} {
        allow read: if ehEquipe();
        allow create: if equipeOuDono(empresaId);
        allow update: if false;

        // Apagar evento a evento continua proibido — é o que dá
        // sentido à trilha. A exceção é admin, e existe por um
        // motivo prático: sem ela, excluir uma empresa deixaria
        // os eventos órfãos no banco para sempre, invisíveis no
        // console e ainda assim cobrados.
        allow delete: if ehAdmin();
      }
    }

    // ---------- Pedidos de exclusão de conta de login ----------
    //
    // O painel não consegue apagar uma conta do Authentication: isso
    // exige poder de administrador do projeto, que não pode morar
    // dentro de uma página web. Então o painel GRAVA UM PEDIDO aqui
    // e uma função do servidor reage à gravação.
    //
    // Foi assim que ficou depois de a versão por HTTPS não passar:
    // função de 2ª geração roda sobre Cloud Run, e liberar a chamada
    // exigiria conceder acesso a `allUsers` — proibido pela política
    // da organização da Totali. Invertendo o sentido, some o
    // endereço público e quem autoriza volta a ser esta regra.
    //
    // Criar é só de admin. Alterar e apagar, de ninguém: o resultado
    // é escrito pelo servidor e o pedido vira registro do que foi
    // feito, com autor e data.
    match /exclusoesDeConta/{pedidoId} {
      allow read: if ehEquipe();
      allow create: if ehAdmin()
                    && request.resource.data.pedidoPor == request.auth.uid
                    && request.resource.data.uids is list
                    && request.resource.data.uids.size() > 0
                    && request.resource.data.uids.size() <= 20;
      allow update, delete: if false;
    }

    // ---------- Pedidos de abertura de senha ----------
    //
    // O painel grava um pedido aqui e a Cloud Function
    // `abrirCredencial` responde no mesmo documento. Mesmo padrão
    // da exclusão de conta, e pelo mesmo motivo: função chamável
    // exigiria liberar `allUsers` no Cloud Run, o que a política
    // da organização proíbe.
    //
    // O PEDIDO CARREGA UMA CHAVE PÚBLICA DESCARTÁVEL, gerada na
    // aba de quem pediu. A função recifra a resposta com ela — e
    // é por isso que nada aqui dentro é legível, nem para quem
    // conseguir ler a coleção inteira. Sem essa recifragem, a
    // senha ficaria em texto puro no documento do pedido, e
    // teríamos trocado um problema por outro.
    //
    // Ler só o próprio pedido: um membro da equipe não precisa
    // ver o que outro pediu — e, mesmo lendo, não abriria, porque
    // a chave de resposta é da aba do outro.
    match /pedidosDeSenha/{pedidoId} {
      allow read: if ehEquipe() && resource.data.pedidoPor == request.auth.uid;
      allow create: if ehEquipe()
                    && request.resource.data.pedidoPor == request.auth.uid
                    && request.resource.data.empresaId is string
                    && request.resource.data.chave is string
                    && request.resource.data.chavePublica is map;
      // A resposta é escrita pela função, que passa por cima das
      // regras. Ninguém edita nem apaga um pedido.
      allow update, delete: if false;
    }

    // ---------- Trilha de auditoria do SERVIDOR ----------
    //
    // A diferença entre esta e a /eventos de cada empresa é toda
    // a diferença que importa: /eventos é escrita pelo navegador
    // e serve para acompanhar; esta é escrita por Cloud Function,
    // com a hora do servidor, e nenhuma das duas pontas consegue
    // tocá-la.
    //
    // `write: false` para todo mundo — cliente, equipe e admin.
    // A função passa por cima destas regras porque roda com poder
    // de administrador do projeto, e é exatamente isso que dá
    // valor ao registro: quem é parte interessada não escreve.
    //
    // Ler é da equipe. É uma trilha de trabalho, não um mural.
    match /auditoria/{registroId} {
      allow read: if ehEquipe();
      allow write: if false;
    }

    // ---------- Conteúdo do portal ----------
    //
    // Textos, documentos do checklist, trilhas da Academy. Todo
    // cliente lê; só a equipe altera. É o que tira o passo de
    // baixar arquivo e publicar.
    match /conteudo/{doc} {
      allow read: if true;
      allow write: if ehEquipe();
    }

    // ---------- Equipe ----------
    //
    // O PRIMEIRO documento aqui é criado à mão pelo console.
    // Depois disso, só admin cria outros. Ninguém se promove.
    match /usuarios/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || ehAdmin();
      allow create, update: if ehAdmin()
                            && request.resource.data.papel in ['admin', 'equipe'];
      allow delete: if ehAdmin() && request.auth.uid != uid;
    }

    // ---------- Tudo o mais ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
